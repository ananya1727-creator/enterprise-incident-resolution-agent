# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Logs / scratch
*.log

# Regenerable run artifacts (produced by main.py / scripts/run_*.py).
# Curated summaries (reports/EVALUATION_REPORT.md, reports/E2E_TEST_REPORT.md)
# ARE tracked -- only the raw per-incident traces are excluded here.
runs/*.json
runs/*.timeline.txt

# Runtime-accumulated case memory / escalation archive (grows with every
# run; start empty on a fresh clone -- agent/data_store.py handles a
# missing file gracefully).
data/learned_resolutions.json
data/escalation_archive.json

# OS cruft
.DS_Store
Thumbs.db
